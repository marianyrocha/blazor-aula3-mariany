@page "/produtos"
@using BlazorApp1.Components.Models
<div class="row">
    <Cartao Titulo="Produtos">
        <FormProduto AdicionarProduto="AdicionarProduto"/>
    </Cartao>

    <div class="col-md-8">
        <TabelaProdutos produtos="produtos"/>
        @if (produtos.Count == 0)
        {
            <AvisoVazio Mensagem="Nenhum produto cadastrado"/>
        }
    </div>
    
</div>

@code {
    private Produto produto = new();
    
    private List<Produto> produtos = new();

    private void AdicionarProduto(Produto novo)
    {
        produtos.Add(novo);
    }
}